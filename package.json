{
  "name": "maya-goyomi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/dev.mjs",
    "dev:nuxt": "nuxt dev",
    "generate": "NITRO_PRESET=static nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "emulators": "firebase emulators:start --import=./.firebase-emulator-data --export-on-exit",
    "seed:characters": "tsx --env-file=.env scripts/seedCharacters.ts",
    "seed:characters:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seedCharacters.ts",
    "seed:tones": "tsx --env-file=.env scripts/seedTones.ts",
    "seed:tones:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seedTones.ts",
    "seed:kins": "tsx --env-file=.env scripts/seedKins.ts",
    "seed:kins:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seedKins.ts",
    "cleanup:legacy-content": "tsx --env-file=.env scripts/deleteLegacyContent.ts",
    "cleanup:legacy-content:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/deleteLegacyContent.ts",
    "backfill:caution-split": "tsx --env-file=.env scripts/backfillCautionSplit.ts",
    "backfill:caution-split:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/backfillCautionSplit.ts",
    "migrate:bulletFields": "tsx --env-file=.env scripts/migrateBulletFields.ts",
    "migrate:bulletFields:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/migrateBulletFields.ts"
  },
  "dependencies": {
    "firebase": "^11.3.1",
    "firebase-admin": "^14.2.0",
    "nuxt": "^3.21.9",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "firebase-tools": "^15.24.0",
    "tsx": "^4.23.1"
  }
}
