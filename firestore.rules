rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /diagnosisContent/{docId} {
      allow read: if true;
      // 書き込みは現在すべて無効。管理者認証（admin:trueカスタムクレーム＋
      // クライアント側判定）は別ブランチで用意済みだが、まだmainにはマージして
      // いない。サーバーも無い（server/を撤廃済み）ため、bypassする経路も無い。
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false; // deny-by-default; no other collections exist yet
    }
  }
}
