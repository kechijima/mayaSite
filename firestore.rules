rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /diagnosisContent/{docId} {
      allow read: if true;
      allow write: if false; // writes go through server/api/admin/content/[id].put.ts via firebase-admin, which bypasses rules
    }
    match /{document=**} {
      allow read, write: if false; // deny-by-default; no other collections exist yet
    }
  }
}
