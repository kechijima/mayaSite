rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // 自己登録(pages/signup.vue)はplanを必ず'free'で作成する — 自分で'paid'を
      // 名乗れないようにするため。createdAt == request.timeはserverTimestamp()の
      // 送信を強制し、偽装された固定値を弾く(diagnosisHistoryのcreateと同じパターン)。
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && request.resource.data.createdAt == request.time;
      // 本人は氏名・電話番号などのプロフィール項目を編集できるが、planフィールドには
      // 触れない — 決済導入前に自己申告で有料化できてしまうのを防ぐため。planの変更
      // (将来、決済確認後や手動での有料化)は管理者のみ。
      allow update: if isAdmin()
        || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']));
      allow delete: if false;
    }

    match /diagnosisContent/{docId} {
      allow read: if true;
      // /admin/content から直接書き込む(サーバー無し)。admin:trueカスタムクレームを
      // 持つ認証済みユーザーのみ許可 — middleware/admin-auth.global.ts はUIのガードに
      // 過ぎず、実際の防御はここ(CLAUDE.md「Admin authentication」参照)。
      allow write: if isAdmin();
    }
    match /diagnosisHistory/{docId} {
      // 診断者本人の名前・生年月日・性別を含むため、閲覧は管理画面(/admin/history)の
      // 管理者のみに限定。送信(create)自体は診断フォームを使う一般利用者による
      // 未認証アクセスなので、従来通り認証不要のまま。
      allow read: if isAdmin();
      // createdAt == request.time は serverTimestamp() の送信を強制し、偽装された
      // 固定値を弾く(Firestoreルールの標準パターン)。それ以上の項目別バリデーションは
      // このファイル全体のミニマルな方針に合わせて意図的に省略。
      allow create: if request.resource.data.type in ['single', 'compatibility']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false; // deny-by-default; no other collections beyond the above exist yet
    }
  }
}
