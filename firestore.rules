rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /diagnosisContent/{docId} {
      allow read: if true;
      // admin:trueカスタムクレームを持つ認証済みユーザーのみ書き込み可。
      // サーバー経由ではなく pages/admin/content.vue から直接書き込む。
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /{document=**} {
      allow read, write: if false; // deny-by-default; no other collections exist yet
    }
  }
}
