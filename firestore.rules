rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 有料本文(diagnosisContentPremium/{docId})の閲覧権限。composables/useEntitlement.ts の
    // canRead(docId) と対で書き換えること(CLAUDE.md「Member status and the paid-area gate」)。
    //
    //   利用停止でない かつ (有料会員 plan == 'paid'
    //                        または チーム所属 teamId != null
    //                        または その docId が単体購入で解放済み users/{uid}/unlocks/{docId})
    //
    // 単体購入(KIN N の記事)は「解放されるドキュメントID」を 1 件ずつ unlocks に置く。
    // rules は購入一覧を走査できないが exists() なら引けるため(CLAUDE.md Phase 2 の案を
    // この形に改めた。2026-09-23)。
    //
    // 2026-09-09: 判定を「チームに所属していること」から「登録していて停止でない」へ。
    // 2026-09-23: 決済フローの導入に合わせ「有料会員・チーム会員・単体購入」に限定した。
    //             無料会員は読めない。plan/unlocks を書くのは本来サーバー(Stripe の Webhook)だが、
    //             決済モック期間は本人にも書かせている(users の update 4本目と purchases/unlocks)。
    // get(key, default) なのは suspended/plan を持たない既存会員を弾かないため。
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isEntitledFor(docId) {
      return request.auth != null
        && userDoc().get('suspended', false) != true
        && (userDoc().get('plan', 'free') == 'paid'
            || userDoc().get('teamId', null) != null
            || exists(/databases/$(database)/documents/users/$(request.auth.uid)/unlocks/$(docId)));
    }

    // 紹介コードのドキュメントを引く。存在しなければ null を返すので、呼び出し側で
    // null チェックしてから status/teamId を見ること。同一リクエスト内の同じパスへの
    // get() はFirestoreがキャッシュするため、複数回呼んでも読み取り課金は1回。
    function codeDoc(code) {
      return exists(/databases/$(database)/documents/referralCodes/$(code))
        ? get(/databases/$(database)/documents/referralCodes/$(code)).data
        : null;
    }

    // 本人がコードを使って自分の権限を解放する書き込みの検証。書き込もうとしている
    // teamId/teamName が、そのコードのドキュメントが持つ値と一致することまで要求している —
    // これが無いと、有効なコードを1つ知っている人が「別のチームに所属している」と
    // 名乗れてしまう。
    // teamName を users 側にも持たせているのは、/account で所属チーム名を表示するため。
    // referralTeams は管理者専用で、管理者に追加されたメンバーはコードも知らないため、
    // 非正規化しないと本人が自分の所属チーム名に到達できない。チーム改称時に古い名前が
    // 残るが、表示用の文字列なので許容している(所属の正は teamId)。
    function redeemsCode(data) {
      return data.referralCodeId is string
        && data.entitlementSource == 'code'
        && data.referralRedeemedAt == request.time
        && codeDoc(data.referralCodeId) != null
        && codeDoc(data.referralCodeId).status == 'active'
        && codeDoc(data.referralCodeId).teamId == data.teamId
        && codeDoc(data.referralCodeId).teamName == data.teamName;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // 自己登録(pages/signup.vue)はplanを必ず'free'で作成する — 自分で'paid'を
      // 名乗れないようにするため。createdAt == request.timeはserverTimestamp()の
      // 送信を強制し、偽装された固定値を弾く(diagnosisHistoryのcreateと同じパターン)。
      //
      // plan と suspended は本人が決められない。登録時は必ず「無料会員・停止なし」で作る。
      // 紹介コードは任意入力。空で登録する場合も紹介系フィールドを明示的に null で
      // 書かせる(省略させない) — フィールドが存在しないと、後から /account でコードを
      // 入れるときの update 側で resource.data の参照がエラーになり弾かれてしまうため。
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && request.resource.data.suspended == false
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.referralCodeId == null
            && request.resource.data.teamId == null
            && request.resource.data.teamName == null
            && request.resource.data.entitlementSource == null
            && request.resource.data.referralRedeemedAt == null)
          || redeemsCode(request.resource.data)
        );

      // 1本目: 管理者。会員ステータス(plan/suspended)の変更は /admin/users、
      //   チームへの追加・除外は /admin/teams/[teamId].vue。どちらもこの経路。
      // 2本目: 本人による通常のプロフィール編集。
      //   plan と suspended は自己申告での有料化・停止解除を防ぐため触らせない。
      //   紹介系フィールドも、正しいコードを伴う3本目以外では触らせない。
      // 3本目: 本人による後追いのコード入力(pages/account.vue)。
      //   条件は「利用停止されていない」かつ「今どこのチームにも所属していない」こと。
      //   所属中はここが false になるため、別チームへの乗り換えはできない。
      //   利用停止中を弾いているのは、停止された人が自分で入り直して停止を無効化
      //   できないようにするため(解除は管理者のみ)。
      //   コード登録で所属するとチーム会員になる(現在は会員全員が閲覧可なので閲覧可否は変わらない)。
      //   get(key, default) を使うのは、フィールドが「存在しない」既存会員を弾かないため。
      //   直接参照すると、この機能より前に登録した会員のドキュメントでは参照そのものが
      //   評価エラーになり、正当な操作まで拒否される(2026-09-07、本番で実際に発生)。
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['plan', 'suspended', 'teamId', 'teamName',
                          'entitlementSource', 'referralCodeId', 'referralRedeemedAt']))
        || (isOwner(uid)
            && resource.data.get('suspended', false) != true
            && resource.data.get('teamId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['teamId', 'teamName', 'entitlementSource',
                           'referralCodeId', 'referralRedeemedAt'])
            && redeemsCode(request.resource.data))
        // 4本目【決済モック期間限定】: 本人が plan を 'paid' / 'free' に切り替える。
        //   仮の決済画面(/checkout/pay)の「支払う」とマイページの「解約する(仮)」が使う。
        //   Stripe 導入後はサーバー(Webhook)だけが書くので、この分岐は削除すること。
        //   利用停止中は不可(停止は購入より優先 — Phase 2 の合意)。
        || (isOwner(uid)
            && resource.data.get('suspended', false) != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'paidAt'])
            && request.resource.data.plan in ['paid', 'free']);

      allow delete: if false;

      // 記事の単体購入。purchases/kin-{N} が購入の記録(マイページの一覧用)、
      // unlocks/{contentDocId} が解放されたドキュメント 1 件ずつ(isEntitledFor が exists() で引く)。
      // 【決済モック期間限定】本人が作れる。Stripe 導入後はサーバーだけが書くので create を
      // isAdmin() に戻すこと。読むのは本人と管理者。消せない(返金の扱いは未決定)。
      match /purchases/{purchaseId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.get('suspended', false) != true
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /unlocks/{contentDocId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.get('suspended', false) != true
          && request.resource.data.purchasedAt == request.time;
        allow update, delete: if false;
      }
    }

    // チームの実体。名前・現在のコード・管理者メモを持つ。管理者専用で、コードを
    // 知っているだけでは読めない — referralCodes と分けているのはこのため
    // (あちらは get を全開放しているので、メモをあちらに置くと漏れる)。
    match /referralTeams/{teamId} {
      allow read, write: if isAdmin();
    }

    // コード → チームの引き当て表。ドキュメントIDがコード文字列そのもの。
    // get だけを開放しているのが要点で、これにより pages/signup.vue が入力された
    // コードの有効性をその場で確認できる一方、コードを知らない人は1件も取得できず、
    // list(列挙)は管理者に限られるため全コードの吸い出しも成立しない。
    // ここに置くのは signup 画面の確認表示に必要な最小限だけ(teamId/teamName/status)。
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 紹介コード付き会員登録(pages/signup/referral.vue)と /account のチーム選択プルダウン用の
    // 公開チーム一覧。{ name, active } だけを持ち、誰でも読める(チーム名の公開は了承済み)。
    // 管理者メモを含む referralTeams とは分けてある。書き込みは utils/referralTeamAdmin.ts が
    // チーム作成・改名・コードの有効/無効切り替えと同じバッチで行う。
    // ここにコードは置かないこと — 置くと get だけを開けている referralCodes の意味が無くなる。
    match /publicTeams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /diagnosisContent/{docId} {
      allow read: if true;
      // /admin/content から直接書き込む(サーバー無し)。admin:trueカスタムクレームを
      // 持つ認証済みユーザーのみ許可 — middleware/admin-auth.global.ts はUIのガードに
      // 過ぎず、実際の防御はここ(CLAUDE.md「Admin authentication」参照)。
      allow write: if isAdmin();
    }
    // 有料エリアの本文。diagnosisContent と違い読み取りを権限保持者に限定する —
    // Firestoreのルールはフィールド単位で制御できないため、同じドキュメントに
    // 同居させたままでは「無料本文は全公開、有料本文は非公開」が実現できず、
    // 未ログインでも開発者ツールから有料本文を読めてしまう(仕様書9章)。
    match /diagnosisContentPremium/{docId} {
      allow read: if isEntitledFor(docId) || isAdmin();
      allow write: if isAdmin();
    }
    match /diagnosisHistory/{docId} {
      // 診断者本人の名前・生年月日・性別を含むため、閲覧は管理画面(/admin/history)の
      // 管理者のみに限定。送信(create)自体は診断フォームを使う一般利用者による
      // 未認証アクセスなので、従来通り認証不要のまま。
      allow read: if isAdmin();
      // createdAt == request.time は serverTimestamp() の送信を強制し、偽装された
      // 固定値を弾く(Firestoreルールの標準パターン)。それ以上の項目別バリデーションは
      // このファイル全体のミニマルな方針に合わせて意図的に省略。
      allow create: if request.resource.data.type in ['single', 'compatibility']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false; // deny-by-default; no other collections beyond the above exist yet
    }
  }
}
